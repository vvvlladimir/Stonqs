# Cloudflare Pages response headers. The page loads nothing from another origin, and the policy says so.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: interest-cohort=(), camera=(), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=604800
