# Shared by every editor; the real authority is still rustfmt.toml and app/.prettierrc.json,
# which agree with these values at 110 columns.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 110

[*.rs]
indent_size = 4

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.{sql,sh}]
indent_size = 2

[Makefile]
indent_style = tab
