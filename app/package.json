{
  "name": "stonqs-ui",
  "private": true,
  "version": "0.5.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "vite",
    "dev:app": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:browser": "node scripts/browser-dev.mjs",
    "e2e": "playwright test -c e2e",
    "record:ipc": "VITE_RECORD_IPC=1 tauri dev --config src-tauri/tauri.dev.conf.json",
    "record:tour": "node scripts/record-tour.mjs",
    "build": "tsc --noEmit && vite build",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "css:audit": "node scripts/css-audit.mjs",
    "notices": "node ../scripts/notices.mjs",
    "notices:check": "node ../scripts/notices.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lingui/core": "^6.9.0",
    "@lingui/react": "^6.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.1",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lingui/babel-plugin-lingui-macro": "^6.9.0",
    "@lingui/cli": "^6.9.0",
    "@lingui/format-po": "^6.9.0",
    "@lingui/vite-plugin": "^6.9.0",
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.12.0",
    "eslint-plugin-lingui": "^0.16.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
