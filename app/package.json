    "eslint": "^10.10.0",
    "eslint-plugin-lingui": "^0.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
